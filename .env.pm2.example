# PM2 deployment example. Copy to .env.pm2 on the server and adjust values.

NODE_ENV=production

API_PORT=3001
WEB_PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=chcyai
MYSQL_USER=chcy
MYSQL_PASSWORD=chcy123
# You can also set DATABASE_URL directly and skip the MYSQL_* variables above.
# DATABASE_URL=mysql://chcy:chcy123@127.0.0.1:3306/chcyai

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379

NEXT_PUBLIC_API_BASE_URL=https://YOUR_DOMAIN/api
CHCY_CALLBACK_BASE_URL=https://YOUR_DOMAIN

APP_LOGIN_EMAIL=
APP_LOGIN_PASSWORD=
APP_SESSION_SECRET=replace_me_with_a_random_string

CHCY_API_BASE_URL=https://api.chcyai.com
CHCY_ACCESS_KEY=
CHCY_SECRET_KEY=

ALI_OSS_REGION=
ALI_OSS_BUCKET=
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
